# Text and consistent line endings
* text=auto
*.h text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unreal binary assets: LFS + exclusive checkout (requires host lock support)
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable

# Source art and DCC assets
